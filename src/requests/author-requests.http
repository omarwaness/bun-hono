
### get all authors
GET http://localhost:3000/authors

### get author by id = 1
GET http://localhost:3000/authors/1

### create author
POST http://localhost:3000/authors
Content-Type: application/json

{
  "name": "John Doe"
}

### update author id = 1
PUT http://localhost:3000/authors/c6992315-ef12-4ad6-b02b-2b9f290b89c9
Content-Type: application/json

{
  "name": "John Doe Updated"
}

### delete author id = 1
DELETE http://localhost:3000/authors/96400b77-cb2f-4529-b8b4-297ba18b02df